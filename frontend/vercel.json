{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/gateway.ts": { "maxDuration": 300 },
    "api/data.ts": { "maxDuration": 120 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "User-Agent" }]
    },
    {
      "source": "/(dashboard|history|numbers|pairs)",
      "headers": [{ "key": "Vary", "value": "User-Agent" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway" },
    { "source": "/data", "destination": "/api/data" },
    { "source": "/data/:game", "destination": "/api/data?game=:game" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
