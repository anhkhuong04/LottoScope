{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": { "api/gateway.ts": { "maxDuration": 300 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
