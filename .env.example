# Copy to .env for local Docker Compose. Replace both matching placeholders.
POSTGRES_PASSWORD=change-me
LOTTO_DATABASE_URL=postgresql+psycopg://lotto:change-me@postgres:5432/lotto
BACKEND_PORT=8000
FRONTEND_PORT=8088
POSTGRES_PORT=5432
# Optional Vietnam-local polling times (HH:MM):
# LOTTO_LOTTO_POLL_FIRST=14:00
# LOTTO_LOTTO_POLL_SECOND=22:30
# LOTTO_MEGA_POLL=19:30
# LOTTO_POWER_POLL=19:30
# LOTTO_RECONCILE_POLL=07:00
# LOTTO_LATEST_POLL_MINUTES=5
# Docker scheduler defaults to true. Set false when the Windows local sync tasks own polling:
# LOTTO_SCHEDULER_ENABLED=false
# Source requests at least this many seconds apart; increase if Vietlott rate limits:
# LOTTO_SOURCE_REQUEST_INTERVAL=2.0
